# English Assistant backend — EXAMPLE environment file.
# Copy to `.env` for local development and fill in REAL values there.
# NEVER commit a real key. NEVER put a real key in the Android app.
# In production, use your host's secret manager instead of a .env file.

# --- Server ---
PORT=8080
NODE_ENV=development

# --- AI provider (placeholder — do NOT paste a real key here) ---
# Example for an Anthropic key; the provider is chosen in Phase 3.
AI_PROVIDER=anthropic
AI_API_KEY=replace_me_in_local_dotenv_only
AI_MODEL=claude-sonnet-5

# --- App integrity (Firebase App Check / Play Integrity) ---
FIREBASE_PROJECT_ID=replace_me
APP_CHECK_ENABLED=true

# --- Limits ---
MAX_REQUEST_BYTES=8192
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=15000
